# Copy to .env to change anything. All of it is optional.

PORT=3000
# 127.0.0.1 = only this machine. 0.0.0.0 = everyone on your network can use the proxy.
HOST=127.0.0.1
# URL paths used by the proxy and its Wisp (WebSocket) endpoint
# PROXY_PREFIX=/proxy/
# WISP_PATH=/wisp/

# How often the game lists are fetched again, in minutes (they are never saved to disk)
# GAMES_REFRESH_MINUTES=30

# Point a game source at a mirror instead of its default address
# SELENITE_URL=https://selenite.cc
# GNMATH_URL=https://gn-math.dev
# TRUFFLED_URL=https://truffled.lol
# SERAPH_URL=https://ijnfem.github.io/seraph
# CKV_URL=https://chickenkingswebsite.neocities.org
# WASMRIP_URL=https://wasm.rip
