# Where the Express backend runs (used by the rewrites in next.config.ts).
BACKEND_URL=http://127.0.0.1:3000
# Optional: connect the proxy straight to a Wisp server, e.g. wss://backend.example.com/wisp/
# Needed on hosts that can't forward WebSockets. A Wisp URL set in Settings still wins.
NEXT_PUBLIC_WISP_URL=
